# Copy this file to ".env" and fill in real values. Never commit ".env".

# --- Database ---
# Local MySQL running on your computer (default MySQL port 3306)
DATABASE_URL=mysql+pymysql://checkmate_user:changeme@localhost:3306/checkmate

# --- JWT ---
# Generate a strong random secret, e.g. run: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-this-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# --- App ---
ENVIRONMENT=development
# Comma-separated list of allowed origins for CORS (your frontend URL, if any)
ALLOWED_ORIGINS=http://localhost:3000

# --- Rate limiting ---
LOGIN_RATE_LIMIT=5/minute
